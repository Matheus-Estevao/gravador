{
  "name": "Gravador",
  "short_name": "Gravador",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#262624",
  "theme_color": "#1f1e1d",
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "audio", "accept": ["audio/*", ".m4a", ".mp3", ".wav", ".ogg", ".aac", ".flac", ".3gp"] }]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
